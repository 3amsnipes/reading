---
layout: base.njk
wide: true
---
<h1 class="page-title">Reading</h1>
{% for group in collections.books | byYear %}
<h2 class="year">{{ group.year }}</h2>
<ol class="book-grid">
{% for book in group.books %}
  {% set coverTitle = book.data.title %}{% set coverIsbn = book.data.isbn %}
  <li>
    {% if book | hasReview %}<a class="card" href="{{ book.url }}">{% else %}<div class="card">{% endif %}
      {% include "cover.njk" %}
      <span class="title">{{ book.data.title }}</span>
      <span class="author">{{ book.data.author }}</span>
      {% if book.data.rating %}<span class="stars">{{ book.data.rating | stars | safe }}</span>{% endif %}
    {% if book | hasReview %}</a>{% else %}</div>{% endif %}
  </li>
{% endfor %}
</ol>
{% endfor %}
