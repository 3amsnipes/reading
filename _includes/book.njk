---
layout: base.njk
---
{% set coverTitle = title %}{% set coverIsbn = isbn %}{% set coverFile = page.fileSlug | localCover %}
<article class="book{% if dnf %} is-dnf{% endif %}">
  <header class="book-head">
    {% include "cover.njk" %}
    <div>
      <h1>{{ title }}</h1>
      {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
      <p class="meta">
        {{ author }}{% if series %}<br>{{ series }}{% endif %}<br>
        {% if dnf %}Did not finish{% elif reread %}Reread{% else %}Read{% endif %}{% if precision == "year" %} in{% endif %} {{ page.date | readDate(precision) }}
      </p>
      <p class="row">
        {% if rating %}<span class="stars">{{ rating | stars | safe }}</span>{% endif %}
        {% if dnf %}<span class="tag">DNF</span>{% endif %}
        {% if reread %}<span class="tag">Reread</span>{% endif %}
      </p>
    </div>
  </header>
  <div class="review">
    {{ content | safe }}
  </div>
  <p class="back"><a href="/">← All books</a></p>
</article>
